  {
    "name": "save_tests",
    "description": "Save a new immutable mocked-test suite for an explicit action version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "inputs": {
                "type": "object"
              },
              "expected": {},
              "mocks": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "tool": {
                      "type": "string",
                      "maxLength": 201,
                      "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)?$"
                    },
                    "args": {
                      "type": "array",
                      "maxItems": 30
                    },
                    "result": {},
                    "error": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "times": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  },
                  "required": ["tool", "args"],
                  "oneOf": [
                    {
                      "required": ["result"]
                    },
                    {
                      "required": ["error"]
                    }
                  ],
                  "additionalProperties": false
                }
              },
              "forbidden_calls": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "maxLength": 201,
                  "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)?$"
                }
              }
            },
            "required": ["name", "inputs", "expected"],
            "additionalProperties": false
          }
        }
      },
      "required": ["action", "version", "cases"],
      "additionalProperties": false
    },
    "mutates": true
  },
