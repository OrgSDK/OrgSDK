{
  "name": "@orgsdk/executor",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "OrgSDK project executor with persistent files and reusable action workers",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrgSDK/OrgSDK.git",
    "directory": "runtime"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "worker": "node dist/worker.js",
    "supervisor": "node dist/supervisor.js",
    "build": "tsx scripts/build.ts",
    "prepack": "npm run build",
    "smoke:node": "node scripts/verify-runtime-package.mjs node",
    "smoke:bun": "node scripts/verify-runtime-package.mjs bun",
    "test:unit": "bun ../scripts/test.ts unit src",
    "test:integration": "bun ../scripts/test.ts integration src"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "typescript": "~6.0.3",
    "zod": "^4.0.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "bin": {
    "orgsdk-executor": "bin/orgsdk-executor.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "scripts/install-service.sh",
    "systemd/"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "os": [
    "linux"
  ]
}
