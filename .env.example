# Bind locally unless a trusted reverse proxy is configured.
HOST=127.0.0.1
PORT=8080
# Optional absolute path. Defaults to ~/.local/share/orgsdk-bun.
# ORGSDK_DATA_DIR=/path/to/new/orgsdk-data
# OAuth callback origin must match the workspace hostname. HTTPS is required
# except for loopback HTTP origins.
# ORGSDK_PUBLIC_ORIGIN=http://localhost:8080
# Invitations require SMTP. Port 587 uses STARTTLS; set SMTP_SECURE=true for
# implicit TLS (normally port 465). Credentials are optional but paired.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=orgsdk@example.com
# SMTP_USER=
# SMTP_PASSWORD=
# Shared privately with an optional independent executor.
# LOCAL_EXECUTOR_BOOTSTRAP_TOKEN=

# Public plugin discovery and pinned release metadata. Set both URLs to an empty
# value for offline use; PLUGIN_CATALOG_PATH may point at a local JSON catalog.
# PLUGIN_CATALOG_URL=https://orgsdk.ai/plugins/releases.json
# PLUGIN_MARKETPLACE_URL=https://orgsdk.ai/plugins/catalog.json
# PLUGIN_CATALOG_PATH=
