# make dev copies this file to .env if it does not exist.
# Existing .env files are preserved; process environment variables take precedence.
# Local profiles accept LAN and Tailscale hostnames; membership still authorizes access.
DJANGO_ALLOWED_HOSTS=*
WORKSPACE_SINGLE_HOST_FALLBACK=True
DJANGO_TIME_ZONE=UTC
ENABLE_DEBUG_TOOLBAR=False
# PostgreSQL stores product data, background jobs and shared cache entries.
DATABASE_URL=postgresql://django:local-development-only@127.0.0.1:5433/django_template
# The frontend uses a same-origin proxy; CORS is not needed.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
DJANGO_CSRF_TRUSTED_ORIGINS=

WORKSPACE_INVITE_BASE_URL=http://localhost:5173/workspaces/invite/

# Required before storing provider credentials. Generate once and retain this key.
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Agent-owned external marketplace index (empty means no curated releases).
PLUGIN_CATALOG_PATH=
