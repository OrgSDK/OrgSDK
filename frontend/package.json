{
  "name": "orgsdk-platform-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/monaco-assets.ts --check && npm test && prettier --check . && eslint && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "predev": "tsx scripts/monaco-assets.ts",
    "prebuild": "tsx scripts/monaco-assets.ts",
    "test:unit": "bun ../scripts/test.ts unit tests",
    "test:integration": "bun ../scripts/test.ts integration tests"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@trpc/client": "^11.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.52.2",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-unicorn": "^78.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.1"
  }
}
