{
  "name": "@orgsdk/cli",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "linux"
  ],
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --no-env-file scripts/dev.ts",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "format": "prettier --write server scripts/*.ts bin/*.mjs e2e knip.json package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "format:check": "prettier --check server scripts/*.ts bin/*.mjs e2e knip.json package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "e2e": "bun scripts/e2e.ts",
    "lint": "eslint --max-warnings=0",
    "check": "npm run release:check && npm run test:release && npm run license:check && npm run check:server && npm run deadcode && npm --prefix runtime run typecheck && npm run test:cli && npm test && npm --prefix frontend run check && npm --prefix frontend run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/index.ts migrate",
    "db:check": "bun scripts/check-migrations.ts",
    "build:npm": "tsx scripts/build-npm.ts",
    "test:cli": "node --test bin/*.test.mjs",
    "test:distribution": "esbuild scripts/distribution-smoke.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/distribution-smoke.mjs && node dist/distribution-smoke.mjs",
    "test:distribution:bun": "esbuild scripts/distribution-smoke.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/distribution-smoke.mjs && bun dist/distribution-smoke.mjs",
    "prepack": "npm run build:npm",
    "setup": "npm ci && npm --prefix frontend ci && npm --prefix runtime ci",
    "check:server": "bun run format:check && bun run lint && bun run typecheck && bun run db:check",
    "license:check": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { strictEqual } from 'node:assert'; strictEqual(readFileSync('LICENSE', 'utf8'), readFileSync('runtime/LICENSE', 'utf8'));\"",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved",
    "deadcode:exports": "knip --include exports,types",
    "deps:outdated": "npm outdated; npm --prefix frontend outdated; npm --prefix runtime outdated",
    "prune:empty": "bun scripts/prune-empty.ts",
    "test:unit": "bun scripts/test.ts unit server runtime/src frontend/tests",
    "test:integration": "bun scripts/test.ts integration server runtime/src frontend/tests",
    "container:start": "bun scripts/compose.ts start",
    "container:backup": "bun scripts/compose.ts backup",
    "container:restore": "bun scripts/compose.ts restore",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "test:dev": "bun --no-env-file scripts/dev-smoke.ts",
    "release:check": "tsx scripts/release.ts check",
    "release:plan": "tsx scripts/release.ts plan",
    "release:prepare": "tsx scripts/release.ts prepare",
    "test:release": "bun test scripts/release.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@trpc/server": "^11.24.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.3",
    "drizzle-orm": "^0.45.0",
    "esbuild": "0.28.2",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "typescript": "~6.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "^1.65.0",
    "@trpc/client": "^11.24.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/http-proxy": "^1.17.17",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.14.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "http-proxy": "^1.18.1",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  },
  "version": "0.1.1",
  "description": "Local OrgSDK platform and code executor",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "orgsdk": "bin/orgsdk.mjs"
  },
  "files": [
    "bin/orgsdk.mjs",
    "bin/options.mjs",
    "bin/configuration.mjs",
    "bin/supervision.mjs",
    "dist/server/",
    "dist/runtime/",
    "dist/THIRD_PARTY_NOTICES.txt",
    "docs/npm-distribution.md",
    "docs/remote-mcp.md",
    "runtime/README.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrgSDK/OrgSDK.git"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.1",
    "esbuild": "$esbuild"
  }
}
