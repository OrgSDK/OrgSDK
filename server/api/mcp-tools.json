  {
    "name": "list_project_plugins",
    "description": "List configurable installed package plugins for a granted project. Returns the current configuration, schema, credential status and revision needed to configure a plugin. Credential values are private.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "format": "uuid"
        }
      },
