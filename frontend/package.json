{
  "name": "orgsdk-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "api:generate": "node scripts/api-contract.mjs",
    "api:check": "node scripts/api-contract.mjs --check",
    "format": "prettier --write .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run api:check && node scripts/monaco-assets.mjs --check && npm test && prettier --check . && eslint && tsc --noEmit",
    "dev:all": "concurrently --kill-others --names django,next \"make -C .. run\" \"make -C .. frontend\"",
    "test": "bun test tests",
    "predev": "node scripts/monaco-assets.mjs",
    "prebuild": "node scripts/monaco-assets.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.52.2",
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
