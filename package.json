{
  "name": "orgsdk-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "test": "bun test server",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "format": "prettier --write server scripts/*.ts e2e package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "format:check": "prettier --check server scripts/*.ts e2e package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "e2e": "bun scripts/e2e.ts",
    "lint": "eslint --max-warnings=0",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run db:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/index.ts migrate",
    "db:check": "bun scripts/check-migrations.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0",
    "ajv": "^8.17.1",
    "cron-parser": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
