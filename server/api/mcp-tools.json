  {
    "name": "save_action",
    "description": "Save a new immutable action version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "action": {
          "type": "string",
          "format": "uuid"
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": ["standalone", "session-only", "either"]
            },
            "requires": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "expression": {
                    "type": "string"
                  }
                },
                "required": ["label", "expression"],
                "additionalProperties": false
              }
            },
            "provides": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "expression": {
                    "type": "string"
                  }
                },
                "required": ["label", "expression"],
                "additionalProperties": false
              }
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      },
      "required": ["project", "name", "source"],
      "additionalProperties": false
    },
    "mutates": true
  },
