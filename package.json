{
  "name": "@orgsdk/cli",
  "private": true,
  "os": [
    "linux"
  ],
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "test": "bun test server",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "format": "prettier --write server scripts/*.ts scripts/*.mjs bin/*.mjs e2e package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "format:check": "prettier --check server scripts/*.ts scripts/*.mjs bin/*.mjs e2e package.json tsconfig.json playwright.config.ts eslint.config.mjs drizzle.config.ts",
    "e2e": "bun scripts/e2e.ts",
    "lint": "eslint --max-warnings=0",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run db:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/index.ts migrate",
    "db:check": "bun scripts/check-migrations.ts",
    "build:npm": "node scripts/build-npm.mjs",
    "test:cli": "node --test bin/*.test.mjs",
    "test:distribution": "esbuild scripts/distribution-smoke.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/distribution-smoke.mjs && node dist/distribution-smoke.mjs",
    "prepack": "npm run build:npm"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0",
    "ajv": "^8.17.1",
    "cron-parser": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "@node-rs/argon2": "^2.2.2",
    "esbuild": "0.28.2",
    "pino": "^10.4.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "@types/better-sqlite3": "^9.6.0"
  },
  "version": "0.1.0",
  "description": "Local OrgSDK platform and code executor",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "orgsdk": "bin/orgsdk.mjs"
  },
  "files": [
    "bin/orgsdk.mjs",
    "bin/options.mjs",
    "bin/configuration.mjs",
    "bin/supervision.mjs",
    "dist/server/",
    "dist/runtime/",
    "docs/npm-distribution.md",
    "runtime/README.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OrgSDK/OrgSDK.git"
  }
}
